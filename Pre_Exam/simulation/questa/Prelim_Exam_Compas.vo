	.dataa(gnd),
	.datab(\B~input_o ),
	.datac(\A~input_o ),
	.datad(gnd),
	.cin(gnd),
	.combout(\Y2~1_combout ),
	.cout());
// synopsys translate_off
defparam \Y2~1 .lut_mask = 16'h0C0C;
defparam \Y2~1 .sum_lutc_input = "datac";
// synopsys translate_on

// Location: LCCOMB_X31_Y72_N6
cycloneive_lcell_comb \Y2~2 (
