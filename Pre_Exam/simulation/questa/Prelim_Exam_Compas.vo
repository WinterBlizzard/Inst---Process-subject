`timescale 1 ps/ 1 ps

module Prelim_Exam_Compas (
	Y0,
	Y1,
	Y2,
	Y3,
	A,
	B);
output 	Y0;
output 	Y1;
output 	Y2;
output 	Y3;
input 	A;
input 	B;

// Design Ports Information
// Y0	=>  Location: PIN_A7,	 I/O Standard: 2.5 V,	 Current Strength: Default
// Y1	=>  Location: PIN_F12,	 I/O Standard: 2.5 V,	 Current Strength: Default
// Y2	=>  Location: PIN_B7,	 I/O Standard: 2.5 V,	 Current Strength: Default
// Y3	=>  Location: PIN_G12,	 I/O Standard: 2.5 V,	 Current Strength: Default
// A	=>  Location: PIN_F11,	 I/O Standard: 2.5 V,	 Current Strength: Default
// B	=>  Location: PIN_E11,	 I/O Standard: 2.5 V,	 Current Strength: Default


wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
wire \Y0~output_o ;
wire \Y1~output_o ;
wire \Y2~output_o ;
wire \Y3~output_o ;
wire \B~input_o ;
wire \A~input_o ;
wire \Y0~0_combout ;
wire \Y2~0_combout ;
wire \Y2~1_combout ;
wire \Y2~2_combout ;


hard_block auto_generated_inst(
	.devpor(devpor),
	.devclrn(devclrn),
	.devoe(devoe));

// Location: IOOBUF_X29_Y73_N2
cycloneive_io_obuf \Y0~output (
	.i(!\Y0~0_combout ),
	.oe(vcc),
	.seriesterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\Y0~output_o ),
	.obar());
// synopsys translate_off
defparam \Y0~output .bus_hold = "false";
defparam \Y0~output .open_drain_output = "false";
// synopsys translate_on

// Location: IOOBUF_X33_Y73_N9
cycloneive_io_obuf \Y1~output (
	.i(\Y2~0_combout ),
	.oe(vcc),
	.seriesterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\Y1~output_o ),
	.obar());
// synopsys translate_off
