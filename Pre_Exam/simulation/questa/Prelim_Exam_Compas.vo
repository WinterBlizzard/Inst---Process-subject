// Location: IOOBUF_X27_Y73_N9
cycloneive_io_obuf \Y3~output (
	.i(\Y2~2_combout ),
	.oe(vcc),
	.seriesterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\Y3~output_o ),
	.obar());
// synopsys translate_off
